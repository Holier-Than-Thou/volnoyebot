# Получите API_ID и API_HASH на https://my.telegram.org
API_ID=123456
API_HASH=replace_me

# Токен обычного Telegram-бота от @BotFather и ID администратора.
BOT_TOKEN=replace_me
ADMIN_ID=123456789

# Для бота используйте отдельную сессию, не сессию прежнего userbot.
SESSION_NAME=casino_bot

# Начальный баланс и минимальная ставка.
INITIAL_BALANCE=1000
MIN_BET=1

# Ключ приложения: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=replace_me

# Серверные пути необязательны: локально используются файлы из каталога проекта.
# ENV_FILE=/etc/volnoyebot/volnoyebot.env
# DATA_DIR=/var/lib/volnoyebot
# CASINO_DATABASE_PATH=/var/lib/volnoyebot/casino.sqlite3
# GUESS_SOUND_DATABASE_PATH=/var/lib/volnoyebot/guess_sound.sqlite3
