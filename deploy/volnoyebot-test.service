[Unit]
Description=Volnoyebot test Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=volnoyebot-test
Group=volnoyebot-test
WorkingDirectory=/opt/volnoyebot-test
EnvironmentFile=/etc/volnoyebot-test/volnoyebot.env
Environment=ENV_FILE=/etc/volnoyebot-test/volnoyebot.env
Environment=DATA_DIR=/var/lib/volnoyebot-test
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/volnoyebot-test/.venv/bin/python /opt/volnoyebot-test/bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/volnoyebot-test

[Install]
WantedBy=multi-user.target
